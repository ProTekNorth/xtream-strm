[Unit]
Description=Export Xtream VOD library as STRM files
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xtream-strm
Group=media
Environment=XTREAM_STATUS_FILE=/var/lib/xtream-strm/status.json
ExecStart=/opt/xtream-strm/xtream_strm.py --config /etc/xtream-strm/config.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0007
